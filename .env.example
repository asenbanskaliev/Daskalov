# Copiar estas variables al entorno del servidor. NUNCA subir una clave real al repositorio.
OLLAMA_API_KEY=
OLLAMA_LOCAL_URL=http://127.0.0.1:11434
PORT=3000
# La memoria persiste SOLAMENTE si el servidor privado habilita esta opción.
# No usar con menores en un sitio público sin controles legales y autenticación adicionales.
DASKALOV_ALLOW_MEMORY=0
# Requiere HTTPS terminado en proxy seguro (solo si se configura SSL delante del servidor).
DASKALOV_SECURE_COOKIES=0
# Tarifa opcional para ESTIMACIÓN de coste; no equivale a facturación real.
# Dejar vacía si se desconoce. La métrica /api/metrics NO expone preguntas, usuarios ni direcciones IP.
DASKALOV_USD_PER_1M_OUTPUT_TOKENS=

# TTS local opcional. Instalar Piper y una voz española .onnx con licencia aprobada.
# Los archivos de voz NO se incluyen en el repositorio y no se cargan al navegador.
DASKALOV_PIPER_BIN=
DASKALOV_PIPER_MODEL=

# Servidor whisper.cpp local escuchando SOLO loopback (activar con --convert si recibe webm/ogg).
# Sin esta variable el STT local está inactivo.
DASKALOV_WHISPER_URL=

# Optional Engram-like semantic retrieval: private local Ollama only; disabled by default.
# Pull a suitable embedding model into the local Ollama instance before enabling.
DASKALOV_ENABLE_LOCAL_EMBEDDINGS=0
DASKALOV_EMBED_MODEL=embeddinggemma

# Shared SQLite quota ledger (private multi-process staging only; OFF by default).
# Use same persistent DB volume + long private secret across all Node processes.
DASKALOV_DISTRIBUTED_LIMIT=0
DASKALOV_LEDGER_SECRET=

# STT Cloud optativo y de pago, apagado por defecto. NUNCA cargar claves en el navegador.
DASKALOV_ENABLE_STT_CLOUD=0
DASKALOV_STT_CLOUD_KEY=

# TTS comercial opcional: apagado por defecto, solo backend privado + consentimiento de cada usuario.
DASKALOV_ENABLE_TTS_CLOUD=0
DASKALOV_TTS_CLOUD_KEY=

# Tombstones HMAC external to DB backups; keep key+ledger safe across restores (opt-in private).
DASKALOV_ERASURE_LEDGER_PATH=
DASKALOV_ERASURE_LEDGER_SECRET=
# Fail closed on restore if the tombstone ledger is unavailable; must be 1 before real minors data.
DASKALOV_STRICT_PRIVACY_RESTORE=0
